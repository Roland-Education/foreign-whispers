# Host user — so Docker-created files are owned by you, not root
# Run: id -u && id -g   to find your values
UID=1000
GID=1000

# Hugging Face — required for speaker diarization (pyannote.audio)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=

# Logfire — optional, enables observability traces
# Get yours at https://logfire.pydantic.dev
LOGFIRE_TOKEN=

# ── GPU service hosts ─────────────────────────────────────────────────
# Default: the in-cluster docker containers (whisper-gpu, chatterbox-gpu).
# To offload GPU work to Colab, run notebooks/colab_gpu_services.ipynb,
# paste the two cloudflared URLs it prints below, and set BACKEND=remote
# so the API actually proxies Whisper over HTTP instead of loading locally.
# CHATTERBOX_API_URL=https://abc.trycloudflare.com
# FW_WHISPER_API_URL=https://xyz.trycloudflare.com
# FW_WHISPER_BACKEND=remote
